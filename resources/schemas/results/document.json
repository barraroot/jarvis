{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "document",
    "type": "object",
    "required": [
        "type",
        "title",
        "format",
        "body"
    ],
    "additionalProperties": false,
    "properties": {
        "type": {
            "type": "string",
            "enum": [
                "document"
            ]
        },
        "title": {
            "type": "string"
        },
        "format": {
            "type": "string",
            "enum": [
                "markdown",
                "plain"
            ]
        },
        "body": {
            "type": "string"
        },
        "speech": {
            "type": "string",
            "maxLength": 300
        },
        "suggested_actions": {
            "type": "array",
            "maxItems": 4,
            "items": {
                "type": "object",
                "required": [
                    "label",
                    "request"
                ],
                "additionalProperties": false,
                "properties": {
                    "label": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 40
                    },
                    "request": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 500
                    }
                }
            }
        }
    }
}
