{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "search_results",
    "type": "object",
    "required": [
        "type",
        "query",
        "results"
    ],
    "additionalProperties": false,
    "properties": {
        "type": {
            "type": "string",
            "enum": [
                "search_results"
            ]
        },
        "query": {
            "type": "string"
        },
        "results": {
            "type": "array",
            "items": {
                "type": "object",
                "required": [
                    "title",
                    "snippet",
                    "source"
                ],
                "additionalProperties": false,
                "properties": {
                    "title": {
                        "type": "string"
                    },
                    "url": {
                        "type": "string"
                    },
                    "snippet": {
                        "type": "string"
                    },
                    "source": {
                        "type": "string"
                    }
                }
            }
        },
        "speech": {
            "type": "string",
            "maxLength": 300
        },
        "suggested_actions": {
            "type": "array",
            "maxItems": 4,
            "items": {
                "type": "object",
                "required": [
                    "label",
                    "request"
                ],
                "additionalProperties": false,
                "properties": {
                    "label": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 40
                    },
                    "request": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 500
                    }
                }
            }
        }
    }
}
