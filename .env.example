APP_NAME=JARVIS
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# Production: LOG_STACK=json (daily JSON files) or stderr_json (containers).
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
LOG_DAILY_DAYS=14

DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=laravel
DB_USERNAME=sail
DB_PASSWORD=password

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Defaults to true when APP_ENV=production; keep Lax for the SPA.
SESSION_SECURE_COOKIE=
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="jarvis@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=sail
AWS_SECRET_ACCESS_KEY=password
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=jarvis
AWS_USE_PATH_STYLE_ENDPOINT=true
AWS_ENDPOINT=http://rustfs:9000
AWS_URL=http://localhost:9000/jarvis

VITE_APP_NAME="${APP_NAME}"

SANCTUM_STATEFUL_DOMAINS=localhost,localhost:80,localhost:5173,127.0.0.1,127.0.0.1:80
FRONTEND_URL=http://localhost:5173
# Extra CORS origins (comma separated); APP_URL and FRONTEND_URL are always allowed.
CORS_ALLOWED_ORIGINS=

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
# Address the backend (app, queue) publishes to; under Sail, the reverb container.
REVERB_HOST="reverb"
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
# Probe used by /up; defaults to REVERB_SCHEME://REVERB_HOST:REVERB_PORT/up.
REVERB_HEALTH_URL=

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
# Address the browser connects to (also allowed in the SPA CSP); "${REVERB_HOST}" when both match.
VITE_REVERB_HOST="localhost"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# AI provider keys are managed in the admin panel (encrypted in the
# database); these env keys are only fallbacks read by config/ai.php.
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
# Browser-facing origin of the OpenAI Realtime API (voice), allowed in the SPA
# CSP connect-src; must be an https:// origin without wildcards.
OPENAI_REALTIME_ORIGIN=https://api.openai.com

# First administrator, created by `php artisan db:seed --class=AdminUserSeeder`
# (ADMIN_PASSWORD needs at least 12 characters).
ADMIN_NAME="Administrator"
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# MCP connectors: allow private/loopback hosts only in local development.
MCP_ALLOW_PRIVATE_HOSTS=false
MCP_TIMEOUT_SECONDS=15

